{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndQuotaCheck",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "servicequotas:GetServiceQuota"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyDescribeInRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAddresses",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribePlacementGroups",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSpotInstanceRequests",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "CreateTopLevelResourcesOnlyTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateInternetGateway",
        "ec2:CreatePlacementGroup",
        "ec2:ImportKeyPair"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-2:*:vpc/*",
        "arn:aws:ec2:us-east-2:*:internet-gateway/*",
        "arn:aws:ec2:us-east-2:*:placement-group/*",
        "arn:aws:ec2:us-east-2:*:key-pair/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "CreateInsideTheBenchVpcNewResourceTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-2:*:subnet/*",
        "arn:aws:ec2:us-east-2:*:security-group/*",
        "arn:aws:ec2:us-east-2:*:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "CreateInsideTheBenchVpcParentMustBeTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateRouteTable"
      ],
      "Resource": "arn:aws:ec2:us-east-2:*:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "ModifyAndDeleteOnlyTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateRoute",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteKeyPair",
        "ec2:DeletePlacementGroup",
        "ec2:DeleteRoute",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-2:*:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "SecurityGroupRulesOfTaggedGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:us-east-2:*:security-group-rule/*"
    },
    {
      "Sid": "SetShutdownBehaviorToTerminateOnly",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench",
          "ec2:Attribute/InstanceInitiatedShutdownBehavior": "terminate"
        }
      }
    },
    {
      "Sid": "TurnTerminationProtectionOffOnly",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench",
          "ec2:Attribute/DisableApiTermination": "false"
        }
      }
    },
    {
      "Sid": "LaunchOnlyPlannedTypesOnDemandImdsv2Tagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "strata-bench",
          "ec2:InstanceType": [
            "c7i.8xlarge",
            "c7i.2xlarge",
            "c7i.xlarge"
          ],
          "ec2:InstanceMarketType": "on-demand",
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "LaunchRootVolumesTaggedGp3AtMost150GB",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "strata-bench",
          "ec2:VolumeType": "gp3"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "150"
        }
      }
    },
    {
      "Sid": "LaunchIntoTheBenchNetworkOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-2:*:subnet/*",
        "arn:aws:ec2:us-east-2:*:security-group/*",
        "arn:aws:ec2:us-east-2:*:key-pair/*",
        "arn:aws:ec2:us-east-2:*:placement-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "LaunchCreatesItsNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:network-interface/*"
    },
    {
      "Sid": "LaunchOnlyCanonicalImages",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "amazon",
          "aws:ResourceAccount": "099720109477"
        }
      }
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-2:*:*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateInternetGateway",
            "CreatePlacementGroup",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateSubnet",
            "CreateVpc",
            "ImportKeyPair",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "RetagOnlyTaggedResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-2:*:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench"
        }
      }
    },
    {
      "Sid": "UntagButNeverRemoveTheProjectTag",
      "Effect": "Allow",
      "Action": "ec2:DeleteTags",
      "Resource": "arn:aws:ec2:us-east-2:*:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "strata-bench"
        },
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    }
  ]
}
